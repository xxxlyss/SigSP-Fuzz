# LLM API Keys (at least one required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
XAI_API_KEY=

# Custom API Base URLs (for proxies / compatible endpoints)
# Example: Alibaba Cloud Bailian Anthropic-compatible endpoint
# ANTHROPIC_API_BASE=https://dashscope.aliyuncs.com/apps/anthropic
ANTHROPIC_API_BASE=
OPENAI_API_BASE=
GEMINI_API_BASE=
XAI_API_BASE=
DEEPSEEK_API_BASE=
DASHSCOPE_API_BASE=

# Optional: override workspace path (default: $PWD/workspace)
# FUZZINGBRAIN_HOST_WORKSPACE=/absolute/path/to/workspace
