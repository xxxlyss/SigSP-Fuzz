# Python bytecode
**/__pycache__/
*.pyc
*.pyo
*.egg-info/

# Virtual environments
**/venv/

# Workspace / runtime data
**/workspace/
**/workspace/*
work/

# Logs
**/logs/
*.log

# Temp / test output
**/tmp_*
**/test_*
!tests/test_*
test_trace_output/

# User-specific config
**/examples/llm_config.local.yaml
fuzzingbrain/llm_config.local.yaml
task_view_*/
documentation/analysis/
experiment/

# Test / coverage artifacts
**/coverage.xml
**/coverage.json
**/.coverage
htmlcov/
**/.pytest_cache/
**/.benchmarks/
**/.benchmark_results/

# Eval server runtime
.eval_pids/
FBv2-Dashboard/

# External repos (cloned locally, has its own .git)
Z-Code-Analyzer-Station/

# Environment secrets
**/.env
.env.*
!.env.example

# Firmware results (extracted binaries, squashfs, .so, .ko, .img, etc.)
**/results/

# Firmware images and extracted root filesystems
**/squashfs-root*/
**/firmware/

# Third-party tools (cloned locally)
**/FirmAE-master/
**/Z-VulnSentinel/

# Binary packages
*.deb
*.docx

# Archive and disk image files
*.squashfs
*.7z
*.zip
*.tar.gz
*.cpio
*.cpio.gz
*.img

# Shared objects and kernel modules (firmware extracted)
# Note: fuzzingbrain/hook_*.so are project-authored, kept via exception below
**/extracted/**/*.so
**/extracted/**/*.ko
!fuzzingbrain/hook_*.so
